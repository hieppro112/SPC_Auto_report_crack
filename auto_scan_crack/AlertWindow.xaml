<Window x:Class="auto_scan_crack.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cảnh báo" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        WindowStartupLocation="CenterOwner" Topmost="True" ShowInTaskbar="False"
        Background="#B00020" KeyDown="Window_KeyDown">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1100" Margin="40">
            <TextBlock Text="⚠" Foreground="White" FontSize="110" HorizontalAlignment="Center"/>

            <TextBlock x:Name="lblTitle" Text="LỖI TỰ ĐỘNG" Foreground="White" FontSize="56" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock x:Name="lblMessage" Foreground="White" FontSize="30" Margin="0,24,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

            <Button x:Name="btnClose" Content="ĐÓNG" Click="BtnClose_Click" Margin="0,48,0,0"
                    HorizontalAlignment="Center" Width="260" Height="70" FontSize="28" FontWeight="Bold"
                    Foreground="#B00020" Background="White" BorderThickness="0" Cursor="Hand"/>

            <TextBlock x:Name="lblCountdown" Foreground="#DDFFFFFF" FontSize="20" Margin="0,16,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
