<Window x:Class="auto_scan_crack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Auto Scan Crack" Height="800" Width="1280"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput">

    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBg" Color="#1F2A44"/>
        <SolidColorBrush x:Key="Accent" Color="#2F80ED"/>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Thanh quét PO -->
            <RowDefinition Height="*"/>     <!-- Web nhập thao tác -->
            <RowDefinition Height="Auto"/>  <!-- Thanh trạng thái -->
        </Grid.RowDefinitions>

        <!-- ===== THANH QUÉT PO ===== -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="TERMINAL ID" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                <Border Grid.Column="1" Background="White" CornerRadius="4" Width="180" Height="38"
                        BorderBrush="#99FFFFFF" BorderThickness="2" Margin="0,0,24,0">
                    <TextBox x:Name="txtTerminalId" BorderThickness="0" Background="Transparent"
                             FontSize="18" FontWeight="SemiBold" VerticalContentAlignment="Center"
                             Padding="8,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             ToolTip="Mã máy: quét/gõ mã TRTB… rồi Enter (con trỏ ở đâu cũng được). Tự lưu lại cho lần mở app sau."/>
                </Border>

                <TextBlock Grid.Column="2" Text="MSNV" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                <Border Grid.Column="3" Background="White" CornerRadius="4" Width="180" Height="38"
                        BorderBrush="#99FFFFFF" BorderThickness="2" Margin="0,0,24,0">
                    <TextBox x:Name="txtMsnv" BorderThickness="0" Background="Transparent"
                             FontSize="18" FontWeight="SemiBold" VerticalContentAlignment="Center"
                             Padding="8,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             ToolTip="MSNV: quét/gõ 4–5 chữ số rồi Enter (con trỏ ở đâu cũng được). Tự lưu lại cho lần mở app sau."/>
                </Border>

                <TextBlock Grid.Column="4" Text="QUÉT MÃ" Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>

                <Border Grid.Column="5" Background="White" CornerRadius="4" Width="320" Height="38"
                        BorderBrush="{StaticResource Accent}" BorderThickness="2">
                    <TextBox x:Name="txtPO" BorderThickness="0" Background="Transparent"
                             FontSize="18" FontWeight="SemiBold" VerticalContentAlignment="Center"
                             Padding="8,0" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             ToolTip="Hiện mã đang quét/gõ. Con trỏ ở đâu trong app cũng được: mã máy (TRTB…), MSNV (4–5 số), PO (12 số), rồi Enter. Esc để xóa."/>
                </Border>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="PO hiện tại" Foreground="#99FFFFFF" FontSize="11"/>
                        <TextBlock x:Name="lblCurrentPO" Text="—" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                        <TextBlock x:Name="lblPoTimerCaption" Text="Thời gian PO còn lại" Foreground="#99FFFFFF" FontSize="11"/>
                        <TextBlock x:Name="lblPoRemaining" Text="—" Foreground="#FFD54F" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀ Quay lại" Style="{StaticResource ToolButton}" Click="BtnBack_Click"/>
                    <Button Content="⟳ Tải lại (F5)" Style="{StaticResource ToolButton}" Click="BtnReload_Click"/>
                    <Button Content="⌂ Trang đăng nhập" Style="{StaticResource ToolButton}" Click="BtnHome_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== WEB NHẬP THAO TÁC: tab trình duyệt kiểu Edge (+ thêm, × đóng), tự động chạy trên tab đang chọn ===== -->
        <DockPanel Grid.Row="1">
            <!-- TabControl chỉ dùng làm thanh tiêu đề tab; WebView2 của các tab nằm chung trong browserHost
                 (ẩn/hiện theo tab đang chọn) để đổi tab không phải tạo lại trình duyệt -->
            <TabControl x:Name="tabBrowsers" DockPanel.Dock="Top"
                        SelectionChanged="TabBrowsers_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="#E4E7EC" Padding="6,4,6,0" BorderBrush="#D0D5DD" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TabPanel IsItemsHost="True"/>
                                <Button x:Name="btnAddTab" Content="+" Click="BtnAddTab_Click"
                                        Width="30" Height="28" Margin="4,0,0,2" FontSize="18"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Focusable="False" ToolTip="Mở tab mới"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,4,6,4"/>
                        <Setter Property="MinWidth" Value="120"/>
                    </Style>
                </TabControl.Resources>
            </TabControl>

            <Grid x:Name="browserHost"/>
        </DockPanel>

        <!-- ===== THANH TRẠNG THÁI ===== -->
        <Border Grid.Row="2" Background="#F2F4F7" BorderBrush="#D0D5DD" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblStatus" Grid.Column="0" Text="Đang khởi tạo..." FontSize="12" Foreground="#344054"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="lblUrl" Grid.Column="1" FontSize="12" Foreground="#667085" Margin="16,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
