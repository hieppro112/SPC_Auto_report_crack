<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cấu hình kết nối DB: file mẫu luôn đi kèm exe; connection.txt (nếu có) cũng được copy theo -->
    <None Update="connection.example.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="connection.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
